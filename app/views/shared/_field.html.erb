<%# locals: (form:, attribute:, label:, type: :text_field, hint: nil, error: nil, **options) %>
<% message_id = "#{form.field_id(attribute)}_message" %>
<div class="flex flex-col gap-1.5">
  <%= form.label attribute, label, class: "text-sm font-semibold" %>
  <%= form.public_send type, attribute, **options,
        "aria-invalid": error.present?,
        "aria-describedby": (message_id if error || hint),
        class: class_names("h-12 rounded-xl bg-surface px-3.5 text-base text-ink placeholder:text-muted",
                           "focus:outline-2 focus:outline-offset-0 focus:outline-accent",
                           error ? "border-2 border-danger-ink" : "border border-field") %>
  <% if error %>
    <p id="<%= message_id %>" class="text-xs font-medium text-danger-ink"><%= error %></p>
  <% elsif hint %>
    <p id="<%= message_id %>" class="text-xs text-muted"><%= hint %></p>
  <% end %>
</div>
